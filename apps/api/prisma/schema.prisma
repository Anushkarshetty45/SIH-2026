// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ASHA_WORKER
  PHC_STAFF
  DOCTOR
  FACILITY_STAFF
  HOSPITAL_ADMIN
  AMBULANCE_STAFF
  SUPER_ADMIN
}

enum Language {
  MARATHI
  HINDI
  ENGLISH
}

enum FacilityType {
  PHC
  CHC
  DISTRICT_HOSPITAL
  CITY_HOSPITAL
  PRIVATE_CLINIC
}

enum FacilityStatus {
  ACTIVE
  INACTIVE
}

enum ConsentStatus {
  PENDING
  GRANTED
  REVOKED
}

enum ReferralStatus {
  PENDING_DOCTOR_APPROVAL
  APPROVED
  REJECTED
  TIMED_OUT
  CANCELLED
  COMPLETED
}

enum NotificationChannel {
  IN_APP
  PUSH
  SOCKET
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  READ
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum SlotStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

enum DayOfWeek {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

enum TransportStatus {
  DISPATCHED
  EN_ROUTE
  ARRIVED
  COMPLETED
  CANCELLED
}

enum BedCategory {
  GENERAL
  ICU
  OXYGEN
  VENTILATOR
  MATERNITY
  PEDIATRIC
}

enum BedStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  UNAVAILABLE
}

enum EquipmentStatus {
  OPERATIONAL
  UNDER_MAINTENANCE
  DEFECTIVE
  UNAVAILABLE
}

enum StockTransactionType {
  RECEIPT
  ISSUE
  ADJUSTMENT
  CORRECTION
}

enum StockStatus {
  AVAILABLE
  LOW_STOCK
  OUT_OF_STOCK
}


// ─────────────────────────────────────────────────────────────────────────────
// User
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  phone             String?   @unique
  name              String
  role              UserRole
  passwordHash      String
  refreshTokenHash  String?
  preferredLanguage Language  @default(MARATHI)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  Doctor              Doctor?
  AdminFacility       Facility?           @relation("FacilityAdmin")
  Referrals           Referral[]          @relation("ReferralCreator")
  DoctorReferrals     Referral[]          @relation("ReferralDoctor")
  AuditLogs           AuditLog[]
  AmbulanceOps        Ambulance[]
  PatientRegistrations Patient[]          @relation("PatientRegisteredBy")
  UpdatedBeds         Bed[]               @relation("BedUpdatedBy")
  UpdatedEquipment    Equipment[]         @relation("EquipmentUpdatedBy")
  UpdatedStocks       MedicineStock[]     @relation("StockUpdatedBy")
  CreatedStockTx      StockTransaction[]  @relation("StockTransactionCreatedBy")
  Notifications       Notification[]      @relation("UserNotifications")

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Facility
// ─────────────────────────────────────────────────────────────────────────────

model Facility {
  id            String         @id @default(cuid())
  name          String
  type          FacilityType
  status        FacilityStatus @default(ACTIVE)
  address       String
  district      String
  state         String
  pincode       String
  latitude      Float?
  longitude     Float?
  contactPhone  String?
  adminId       String?        @unique
  admin         User?          @relation("FacilityAdmin", fields: [adminId], references: [id])
  lastUpdatedAt DateTime       @default(now()) @updatedAt
  createdAt     DateTime       @default(now())

  Doctors             Doctor[]
  ReferralsFrom       Referral[]          @relation("ReferralFromFacility")
  ReferralsTo         Referral[]          @relation("ReferralToFacility")
  Appointments        Appointment[]
  Ambulances          Ambulance[]
  EmergencyTransports EmergencyTransport[]
  Beds                Bed[]
  Equipment           Equipment[]
  MedicineStocks      MedicineStock[]
  ImportBatches       InventoryImportBatch[]

  @@map("facilities")
}

// ─────────────────────────────────────────────────────────────────────────────
// Doctor
// ─────────────────────────────────────────────────────────────────────────────

model Doctor {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  facilityId       String
  facility         Facility @relation(fields: [facilityId], references: [id])
  specialization   String
  registrationNo   String   @unique
  isAvailable      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  Schedules    DoctorSchedule[]
  Slots        AppointmentSlot[]
  Appointments Appointment[]
  Referrals    Referral[]       @relation("ReferralReceivingDoctor")

  @@map("doctors")
}

// ─────────────────────────────────────────────────────────────────────────────
// Patient
// ─────────────────────────────────────────────────────────────────────────────

model Patient {
  id                String        @id @default(cuid())
  name              String
  dateOfBirth       DateTime?
  gender            String?
  phone             String?
  address           String?
  district          String?
  state             String?
  /// National ABHA identifier — nullable; ABHA is optional
  abhaId            String?       @unique
  preferredLanguage Language      @default(MARATHI)
  consentStatus     ConsentStatus @default(PENDING)
  registeredById    String?
  registeredBy      User?         @relation("PatientRegisteredBy", fields: [registeredById], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  Consents     Consent[]
  Referrals    Referral[]
  Appointments Appointment[]
  Transports   EmergencyTransport[]

  @@map("patients")
}

// ─────────────────────────────────────────────────────────────────────────────
// Consent
// ─────────────────────────────────────────────────────────────────────────────

model Consent {
  id          String        @id @default(cuid())
  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  purpose     String        // e.g. "ABDM_LINK", "HEALTH_RECORD_SHARE", "REFERRAL"
  status      ConsentStatus @default(PENDING)
  grantedAt   DateTime?
  revokedAt   DateTime?
  expiresAt   DateTime?
  metadata    Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("consents")
}

// ─────────────────────────────────────────────────────────────────────────────
// Doctor Schedule & Slots
// ─────────────────────────────────────────────────────────────────────────────

model DoctorSchedule {
  id         String    @id @default(cuid())
  doctorId   String
  doctor     Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  facilityId String
  dayOfWeek  DayOfWeek
  startTime  String    // "HH:MM" format
  endTime    String
  slotDurationMinutes Int @default(15)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([doctorId, facilityId, dayOfWeek])
  @@map("doctor_schedules")
}

model AppointmentSlot {
  id         String     @id @default(cuid())
  doctorId   String
  doctor     Doctor     @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  facilityId String
  date       DateTime   @db.Date
  startTime  String     // "HH:MM"
  endTime    String
  status     SlotStatus @default(AVAILABLE)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  Appointment Appointment?

  /// Unique: one slot per doctor per date per time
  @@unique([doctorId, date, startTime])
  @@index([doctorId, date, status])
  @@map("appointment_slots")
}

// ─────────────────────────────────────────────────────────────────────────────
// Appointment
// ─────────────────────────────────────────────────────────────────────────────

model Appointment {
  id         String            @id @default(cuid())
  patientId  String
  patient    Patient           @relation(fields: [patientId], references: [id])
  doctorId   String
  doctor     Doctor            @relation(fields: [doctorId], references: [id])
  facilityId String
  facility   Facility          @relation(fields: [facilityId], references: [id])
  slotId     String            @unique
  slot       AppointmentSlot   @relation(fields: [slotId], references: [id])
  status     AppointmentStatus @default(SCHEDULED)
  notes      String?
  referralId String?           @unique
  referral   Referral?         @relation(fields: [referralId], references: [id])
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@map("appointments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Referral
// ─────────────────────────────────────────────────────────────────────────────

model Referral {
  id                    String         @id @default(cuid())
  patientId             String
  patient               Patient        @relation(fields: [patientId], references: [id])
  createdById           String
  createdBy             User           @relation("ReferralCreator", fields: [createdById], references: [id])
  fromFacilityId        String
  fromFacility          Facility       @relation("ReferralFromFacility", fields: [fromFacilityId], references: [id])
  toFacilityId          String
  toFacility            Facility       @relation("ReferralToFacility", fields: [toFacilityId], references: [id])
  receivingDoctorId     String?
  receivingDoctor       Doctor?        @relation("ReferralReceivingDoctor", fields: [receivingDoctorId], references: [id])
  respondingDoctorId    String?
  respondingDoctor      User?          @relation("ReferralDoctor", fields: [respondingDoctorId], references: [id])
  status                ReferralStatus @default(PENDING_DOCTOR_APPROVAL)
  urgency               String         @default("NORMAL") // NORMAL | HIGH | EMERGENCY
  clinicalNotes         String?
  rejectionReason       String?
  timeoutAt             DateTime?
  respondedAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  Appointment Appointment?

  @@index([status, timeoutAt])
  @@index([patientId])
  @@map("referrals")
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit Log
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String   // e.g. "REFERRAL_CREATED", "APPOINTMENT_BOOKED"
  entity    String   // e.g. "Referral", "Appointment"
  entityId  String
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Ambulance & Emergency Transport
// ─────────────────────────────────────────────────────────────────────────────

model Ambulance {
  id                String    @id @default(cuid())
  vehicleNumber     String    @unique
  operatorId        String
  operator          User      @relation(fields: [operatorId], references: [id])
  currentFacilityId String?
  currentFacility   Facility? @relation(fields: [currentFacilityId], references: [id])
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  Transports EmergencyTransport[]

  @@map("ambulances")
}

model EmergencyTransport {
  id                 String          @id @default(cuid())
  ambulanceId        String
  ambulance          Ambulance       @relation(fields: [ambulanceId], references: [id])
  patientId          String?
  patient            Patient?        @relation(fields: [patientId], references: [id])
  receivingFacilityId String
  receivingFacility  Facility        @relation(fields: [receivingFacilityId], references: [id])
  emergencyDetails   String?
  status             TransportStatus @default(DISPATCHED)
  dispatchedAt       DateTime        @default(now())
  arrivedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@map("emergency_transports")
}

// ─────────────────────────────────────────────────────────────────────────────
// Bed Availability (D2)
// ─────────────────────────────────────────────────────────────────────────────

model Bed {
  id            String      @id @default(cuid())
  facilityId    String
  facility      Facility    @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  bedNumber     String
  ward          String
  category      BedCategory @default(GENERAL)
  status        BedStatus   @default(AVAILABLE)
  lastUpdatedAt DateTime    @default(now()) @updatedAt
  updatedById   String?
  updatedBy     User?       @relation("BedUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())

  @@unique([facilityId, bedNumber])
  @@index([facilityId, status])
  @@index([facilityId, category])
  @@index([lastUpdatedAt])
  @@map("beds")
}

// ─────────────────────────────────────────────────────────────────────────────
// Equipment Availability (D2)
// ─────────────────────────────────────────────────────────────────────────────

model Equipment {
  id                String          @id @default(cuid())
  facilityId        String
  facility          Facility        @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  name              String
  category          String
  totalQuantity     Int             @default(1)
  availableQuantity Int             @default(1)
  status            EquipmentStatus @default(OPERATIONAL)
  lastUpdatedAt     DateTime        @default(now()) @updatedAt
  updatedById       String?
  updatedBy         User?           @relation("EquipmentUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())

  @@unique([facilityId, name])
  @@index([facilityId, status])
  @@index([lastUpdatedAt])
  @@map("equipment")
}

// ─────────────────────────────────────────────────────────────────────────────
// Medicine Reference Data & Inventory (D2 Milestone 2)
// ─────────────────────────────────────────────────────────────────────────────

model Medicine {
  id                     String                @id @default(cuid())
  name                   String
  genericName            String
  dosageForm             String                // TABLET, SYRUP, INJECTION, CAPSULE, OINTMENT, etc.
  strength               String                // e.g. "500mg", "250mg/5ml"
  category               String?               // e.g. "Analgesic", "Antibiotic"
  manufacturer           String?
  unit                   String                @default("tablets")
  description            String?
  isActive               Boolean               @default(true)
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  Stocks                 MedicineStock[]
  Transactions           StockTransaction[]
  PrimaryForAlternatives MedicineAlternative[] @relation("PrimaryMedicine")
  AlternativeToMedicines MedicineAlternative[] @relation("AlternativeMedicine")

  @@unique([name, strength, dosageForm])
  @@index([genericName])
  @@index([name])
  @@map("medicines")
}

model MedicineAlternative {
  id                    String    @id @default(cuid())
  medicineId            String
  alternativeMedicineId String
  notes                 String?
  createdAt             DateTime  @default(now())

  medicine              Medicine  @relation("PrimaryMedicine", fields: [medicineId], references: [id], onDelete: Cascade)
  alternativeMedicine   Medicine  @relation("AlternativeMedicine", fields: [alternativeMedicineId], references: [id], onDelete: Cascade)

  @@unique([medicineId, alternativeMedicineId])
  @@index([medicineId])
  @@index([alternativeMedicineId])
  @@map("medicine_alternatives")
}

model MedicineStock {
  id            String             @id @default(cuid())
  facilityId    String
  facility      Facility           @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  medicineId    String
  medicine      Medicine           @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  currentStock  Int                @default(0)
  reorderLevel  Int                @default(10)
  unit          String             @default("units")
  batchNumber   String?
  expiryDate    DateTime?
  lastUpdatedAt DateTime           @default(now()) @updatedAt
  updatedById   String?
  updatedBy     User?              @relation("StockUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())

  Transactions  StockTransaction[]

  @@unique([facilityId, medicineId])
  @@index([facilityId])
  @@index([medicineId])
  @@index([lastUpdatedAt])
  @@map("medicine_stocks")
}

model StockTransaction {
  id              String               @id @default(cuid())
  facilityId      String
  stockId         String?
  stock           MedicineStock?       @relation(fields: [stockId], references: [id], onDelete: Cascade)
  medicineId      String
  medicine        Medicine             @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  type            StockTransactionType
  quantity        Int                  // positive for receipt, negative for issue
  balanceAfter    Int
  batchNumber     String?
  expiryDate      DateTime?
  supplier        String?
  referenceNumber String?
  idempotencyKey  String?
  notes           String?
  createdById     String?
  createdBy       User?                @relation("StockTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())

  @@unique([facilityId, idempotencyKey])
  @@index([facilityId, medicineId])
  @@index([facilityId, createdAt])
  @@index([createdAt])
  @@map("stock_transactions")
}

model InventoryImportBatch {
  id             String    @id @default(cuid())
  facilityId     String
  facility       Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  idempotencyKey String
  totalRows      Int
  successfulRows Int
  failedRows     Int
  errors         Json?
  createdById    String?
  createdAt      DateTime  @default(now())

  @@unique([facilityId, idempotencyKey])
  @@index([facilityId])
  @@map("inventory_import_batches")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notification (D3)
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id             String              @id @default(cuid())
  recipientId    String
  recipient      User                @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  title          String
  message        String
  channel        NotificationChannel @default(IN_APP)
  status         NotificationStatus  @default(SENT)
  idempotencyKey String?             @unique
  data           Json?
  readAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([recipientId, status])
  @@index([recipientId, createdAt])
  @@map("notifications")
}



